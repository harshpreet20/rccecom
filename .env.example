# ─── RCC Merch Store · environment variables ────────────────────────────────
# Copy this file to `.env.local` for local dev, and set the same values in your
# Vercel project settings for production. Everything has a sensible default in
# code, so the store runs even before these are set.

# ── Payment / merchant identity (exposed to the browser to render the QR) ──
# The UPI VPA the QR pays into, e.g. 9650086006@ybl
NEXT_PUBLIC_UPI_ID=9650086006@ybl
# Name the payer sees in their UPI app
NEXT_PUBLIC_UPI_PAYEE_NAME=Racquets Club Community
# WhatsApp number orders are sent to (country code + number, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=919650086006

# ── Pricing (added on top of item prices at checkout) ──
# Flat shipping fee in ₹ (set to 0 for free shipping). Change any time.
NEXT_PUBLIC_SHIPPING_FEE=80
# GST rate applied to the item subtotal, as a percentage.
NEXT_PUBLIC_GST_PERCENT=5

# ── Store branding (optional) ──
NEXT_PUBLIC_STORE_NAME=Racquets Club Community
NEXT_PUBLIC_STORE_SHORT_NAME=RCC
NEXT_PUBLIC_STORE_TAGLINE=Official merch for the RCC family. Wear the community.
NEXT_PUBLIC_SUPPORT_EMAIL=racquetsclubcommunity@gmail.com

# ── Supabase (shared RCC platform database — persists orders) ──
# Uses the PUBLIC anon key: Row Level Security only lets it create orders and
# call the secure lookup_order() RPC — it cannot read the orders table. Leave
# blank to skip persistence (orders still flow via the WhatsApp handoff).
# Find these in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://qpzfnpoijxfvpbzpfogl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
